{
  "$schema": "http://json.schemastore.org/template",
  "author": "Khila Raj Regmi",
  "classifications": [
    "Web",
    "React",
    "ASP.NET Core",
    "Clean Architecture",
    "DDD",
    "PostgreSQL",
    "JWT"
  ],
  "name": "Clean Architecture DDD Web",
  "identity": "DotNet.React",
  "shortName": "DotNet-React",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "DotNet.React",
  "preferNameDirectory": true,
  "defaultName": "MyApplication",
  "description": "Production-ready Clean Architecture + DDD ASP.NET Core template with Identity, JWT, Permission-based Authorization, PostgreSQL, and modular infrastructure + React.",
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".template.config/**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "connectionString": {
      "type": "parameter",
      "datatype": "string",
      "description": "The default PostgreSQL connection string.",
      "replaces": "Host=localhost;Port=5432;Database=DatabaseName;Username=postgres;Password=admin",
      "defaultValue": "Host=localhost;Port=5432;Database=DatabaseName;Username=postgres;Password=admin"
    }
  },
  "postActions": [
    {
      "condition": "",
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "args": {
        "executable": "dotnet",
        "args": "restore"
      },
      "continueOnError": true
    },
    {
      "condition": "",
      "description": "Build the project",
      "manualInstructions": [
        {
          "text": "Run 'dotnet build'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "args": {
        "executable": "dotnet",
        "args": "build"
      },
      "continueOnError": true
    }
  ]
}